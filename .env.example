# KikiJob local and production environment template.
# Copy to .env.local for local development. Never commit real secrets.

# Frontend
VITE_API_BASE_URL=http://localhost:8787/api

# Backend server
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Database
# Local development currently uses SQLite when DATABASE_URL is empty.
# Production should use Supabase PostgreSQL.
DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_PATH=
DATABASE_URL=
POSTGRES_SSL=require
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
POSTGRES_POOL_MAX=8
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# Supabase, for the next production migration phase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes
MAX_RESUME_UPLOAD_BYTES=8388608

# Auth and email delivery, for production email OTP/password reset.
JWT_SECRET=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_MS=60000

# AI providers, server-side only.
AI_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# Optional document parser.
# Default keeps the existing lightweight PDF text parser as fallback.
# Set DOCLING_SERVER_URL only when a separate docling-serve process is deployed.
# Set DOCUMENT_PARSER=docling-python only when the backend runtime has Python + docling installed.
DOCUMENT_PARSER=
DOCLING_SERVER_URL=
DOCLING_TIMEOUT_MS=45000
DOCUMENT_PARSE_TIMEOUT_MS=45000
PYTHON_PATH=

# Optional local browser autofill.
CHROME_PATH=

# Optional demo job seeding.
KIKIJOB_SEED_DEMO_JOBS=false
